# Artefacts de build — vaut pour Timer/, les bancs et les architectures.
build/
.pio/
__pycache__/
*.pyc
.venv/

# En-têtes générés depuis profiles/*.yaml — reconstruits à chaque build.
**/config/generated_profile.h

# Secrets : la clé AES ne doit JAMAIS être versionnée.
*.key
nvs_*.csv
nvs_*.bin

# Réglages locaux de l'outillage (propres au poste, pas au projet)
.claude/settings.local.json

# KiCad : sauvegardes, verrous, fichiers d'état — régénérés en permanence.
*.lck
~*.lck
_autosave-*
*-backups/
*.kicad_prl
*.kicad_pcb-bak
*.kicad_sch-bak

# Exports produits par outils/exporter_architecture.sh
A?_*_20*.zip
